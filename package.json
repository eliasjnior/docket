{
  "name": "docket",
  "private": true,
  "description": "Docket lists the pull requests waiting on you, from the macOS menu bar.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "make -C apps/macos test",
    "lint": "biome check . && make -C apps/macos lint",
    "format": "biome check --write . && make -C apps/macos format",
    "build": "make -C apps/macos build",
    "ci": "./scripts/ci.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2"
  }
}
