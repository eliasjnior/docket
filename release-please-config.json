{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore(release):${component} ${version}",
  "packages": {
    "apps/macos": {
      "component": "macos",
      "release-type": "simple",
      "package-name": "Docket for macOS",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "Config/Version.xcconfig"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "New"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Improved"
        },
        {
          "type": "revert",
          "section": "Reverted"
        },
        {
          "type": "refactor",
          "section": "Internal",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": true
        }
      ],
      "release-as": "1.0.0"
    }
  }
}
